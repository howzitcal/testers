<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Leads</h1>
  <a class="btn btn-secondary" href="/leads/new">Add Lead</a>
</div>
<div class="table-responsive">
  <table class="table table-striped align-middle">
    <thead>
      <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Email</th>
        <th>Status</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% if not leads or #leads == 0 then %>
        <tr><td colspan="5" class="text-muted">No leads yet.</td></tr>
      <% else %>
        <% for _, lead in ipairs(leads) do %>
          <tr>
            <td><%= lead.id %></td>
            <td><%= lead.name %></td>
            <td><%= lead.email %></td>
            <td><span class="badge text-bg-secondary"><%= lead.status %></span></td>
            <td class="text-end">
              <a class="btn btn-sm btn-outline-primary" href="/leads/<%= lead.id %>/edit">Edit</a>
              <form class="d-inline" method="post" action="/leads/<%= lead.id %>/delete"
                    onsubmit="return confirm('Delete this lead?');">
                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
              </form>
            </td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
</div>
